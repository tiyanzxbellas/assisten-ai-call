# Google Gemini API Key (Untuk AI Conversational Agent)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API=your_gemini_api_key_here

# Model Gemini yang digunakan (Default: gemini-3.6-flash)
# Opsi model lain: gemini-3.6-flash, gemini-3.5-flash, gemini-2.5-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Groq API Key (Untuk Speech-to-Text / Transkripsi Suara Whisper Large v3)
# Dapatkan di: https://console.groq.com/keys
GROQ_API=your_groq_api_key_here

# Nomor Owner Bot (Dipisahkan koma jika lebih dari satu). Kosongkan jika publik.
# Contoh: OWNER=628123456789,628987654321,604312345678
OWNER=628123456789

# Custom System Prompt untuk AI (Opsional)
# Kosongkan untuk menggunakan prompt bawaan asisten suara telepon
SYSTEM_PROMPT="Kamu adalah asisten suara AI pintar yang sedang berbicara lewat panggilan telepon WhatsApp. Jawablah dengan singkat, ramah, dan alami (maksimal 2-3 kalimat). JANGAN gunakan format markdown (*, #, -, tabel)."

# Konfigurasi Tambahan TTS (Opsional)
# Karakter suara TTS Anime (Lihat README.md untuk daftar karakter lengkap)
TTS_CHARACTER=特别周 Special Week (Umamusume Pretty Derby)

# Bahasa TTS (Default: Mix)
TTS_LANG=Mix

# Kecepatan Suara TTS (Default: 1.0, Contoh: 1.2 untuk lebih cepat, 0.8 untuk lebih lambat)
TTS_SPEED=1.0
